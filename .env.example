# ─────────────────────────────────────────────
#  FINT BACKEND — Variables de entorno
#  Copiá este archivo como .env y completá los valores
#  cp .env.example .env
# ─────────────────────────────────────────────

# ── Entorno ──────────────────────────────────
NODE_ENV=development        # development | production

# ── Servidor principal ───────────────────────
PORT=5000                   # Puerto del backend Express

# ── Base de datos ────────────────────────────
MONGO_URI=                  # URI de conexión a MongoDB
                            # Ej: mongodb://localhost:27017/fint
                            #     mongodb+srv://user:pass@cluster.mongodb.net/fint

# ── Autenticación ────────────────────────────
JWT_SECRET=                 # Clave para firmar tokens JWT (mínimo 32 caracteres aleatorios)

# ── CORS ─────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
                            # Orígenes permitidos separados por coma
                            # En producción: https://tu-dominio.com

# ── Bootstrap superadmin (solo primera vez) ──
AUTH_BOOTSTRAP_ENABLED=false  # Cambiar a true para crear el primer superadmin
ADMIN_SETUP_KEY=              # Clave para el endpoint /api/auth/bootstrap

# ── IA / Groq ────────────────────────────────
GROQ_API_KEY=               # API key de Groq (llama-3.3-70b + whisper-large-v3)
                            # Obtener en: https://console.groq.com

# ── WhatsApp (datos del owner para iaController) ──
WHATSAPP_OWNER_EMAIL=       # Email del usuario owner en la DB (usado por iaController)

# ─────────────────────────────────────────────
#  WHATSAPP WORKER (proceso separado)
#
#  El worker corre independiente del backend para que
#  puedas reiniciar el backend sin desconectar WhatsApp.
#
#  Iniciar worker:  npm run dev:worker
#  Iniciar backend: npm run dev
# ─────────────────────────────────────────────

WORKER_PORT=3001            # Puerto donde escucha el worker
WORKER_URL=http://localhost:3001
                            # URL que usa el backend para hablar con el worker
                            # En producción: http://127.0.0.1:3001 (mismo servidor)

WORKER_INTERNAL_SECRET=     # Secreto compartido entre backend y worker
                            # Generá uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
                            # ⚠️  Debe ser el mismo valor en backend y worker (usan el mismo .env)

BACKEND_WEBHOOK_URL=http://localhost:5000/api/whatsapp/webhook/message
                            # URL que usa el worker para enviar mensajes entrantes al backend
                            # En producción: http://127.0.0.1:5000/api/whatsapp/webhook/message
